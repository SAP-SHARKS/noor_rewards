<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "production" matches the App Store distribution profile fetched
	     by Codemagic from App Store Connect. For local development you
	     might switch this to "development" inside a per-config file, but
	     TestFlight + App Store builds both use the production APNs
	     environment. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Sign in with Apple — required by App Store Review Guideline 4.8
	     because we also offer Google Sign-In. "Default" ties the capability
	     to the primary bundle identifier's Apple ID service (no separate
	     Service ID needed for native iOS-only flows). Enable the same
	     capability on the App ID in the Apple Developer portal so the
	     entitlement gets signed into distribution builds. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
