<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Reminder scheduling on Android 13+:
         SCHEDULE_EXACT_ALARM is user-granted — LocalReminderScheduler
         asks the user (from Settings → "Reminders may arrive late") if
         they want exact-time delivery. If they don't grant it, we fall
         back to `AndroidScheduleMode.inexactAllowWhileIdle`, so
         reminders still fire (just within a ~15 min window instead of
         exactly at HH:MM).

         USE_EXACT_ALARM is intentionally NOT declared — it's a
         restricted permission Play only approves for alarm-clock /
         timer / calendar apps. Sabiq is a Quran + dhikr app so
         declaring it risks a policy rejection. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Defensive: if any transitive dependency's merged manifest adds
         USE_EXACT_ALARM, strip it out — see note above on why. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
                     tools:node="remove"/>

    <application
        android:label="Sabiq"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:alwaysRetainTaskState="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase Google OAuth callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.supabase.flutterquickstart" android:host="login-callback" />
            </intent-filter>
            <!-- Quran Foundation OAuth2 PKCE callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="noorrewards" android:host="oauth2" android:pathPrefix="/callback" />
            </intent-filter>

            <!-- Custom Referral Scheme (noorrewards://join?ref=...) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="noorrewards" android:host="join" />
            </intent-filter>

            <!-- Production App Links (https://sabiq-rewards.vercel.app/join?ref=...) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sabiq-rewards.vercel.app" android:pathPrefix="/join" />
            </intent-filter>
        </activity>
        
        <!-- flutter_appauth removed: QF OAuth now uses manual PKCE (url_launcher +
             app_links). The noorrewards://oauth2/callback is handled by MainActivity
             directly via its intent-filter above, matching the proven approach in
             the friend's "Islam Focus" app. No AppAuth activities needed. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Firebase Messaging — defaults for notifications that arrive with a
             `notification` payload. Without these, Android 8+ routes FCM
             messages to an invisible system channel and the push never
             appears. The channel id must match the one created at app start
             via flutter_local_notifications in NotificationService.init(). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="sabiq_default_channel" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Required for flutter_appauth to find a browser for Custom Tabs (Android 11+) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Contact Us: mailto: needs SENDTO+mailto scheme in <queries>
             on Android 11+ or canLaunchUrl() returns false silently even
             when Gmail is installed. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- WhatsApp deep-link for share feature -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>
</manifest>
